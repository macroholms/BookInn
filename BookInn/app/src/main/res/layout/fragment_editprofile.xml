<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
    <ImageButton
        android:id="@+id/BACKBAKBTN"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/strelka"
        android:layout_gravity="start|center"
        android:background="@android:color/transparent"/>
    <TextView
        android:id="@+id/myprofile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="My Profile"
        android:layout_weight="1"
        android:textColor="#322DC2"
        android:textSize="20dp" />
    </LinearLayout>
    <ImageView
        android:id="@+id/profile_picture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:src="@drawable/ic_launcher_foreground"
        android:background="@color/black"/>


    <LinearLayout
        android:id="@+id/resetprofile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/profile_picture"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:gravity="start"
        android:padding="15dp">
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="#363130"
            android:textSize="15dp"/>
        <EditText
            android:id="@+id/nameET"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:padding="10dp"
            android:layout_margin="5dp"
            android:background="@drawable/res1"
            android:hint="Madison Smith"
            android:inputType="text"
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColorHint="#004CA2"
            android:textColor="@color/black"/>
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textColor="#363130"
            android:textSize="15dp"/>
        <EditText
            android:id="@+id/emailET"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:padding="10dp"
            android:layout_margin="5dp"
            android:background="@drawable/res1"
            android:hint="Madisons@Example.Com"
            android:inputType="textEmailAddress"
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColorHint="#004CA2"
            android:textColor="@color/black"/>
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile Number"
            android:textColor="#363130"
            android:textSize="15dp"/>
        <EditText
            android:id="@+id/phoneET"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:padding="10dp"
            android:layout_margin="5dp"
            android:background="@drawable/res1"
            android:hint="+7 913 678 98 89"
            android:inputType="phone"
            android:textStyle="bold"
            android:textColorHint="#004CA2"
            android:textSize="15dp"
            android:textColor="@color/black"/>
        <TextView
            android:textStyle="bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login"
            android:textColor="#363130"
            android:textSize="15dp"/>
        <EditText
            android:id="@+id/loginET"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:padding="10dp"
            android:layout_margin="5dp"
            android:background="@drawable/res1"
            android:hint="madisons@example.com"
            android:inputType="date"
            android:textStyle="bold"
            android:textSize="15dp"
            android:textColorHint="#004CA2"
            android:textColor="@color/black"/>

        <Button
            android:id="@+id/UPDATEBTN"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/purple_btn"
            android:text="Update Profile"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"/>
    </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>