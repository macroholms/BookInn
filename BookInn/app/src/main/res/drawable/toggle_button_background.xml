<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Активное состояние -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/purple_btn" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/white" /> <!-- Белая обводка при активном состоянии -->
        </shape>
    </item>

    <!-- Неактивное состояние -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="24dp" />
            <stroke android:width="2dp" android:color="@color/purple_btn" /> <!-- Синяя обводка при неактивном состоянии -->
        </shape>
    </item>
</selector>