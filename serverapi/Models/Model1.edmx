          <EntitySet Name="v_Active_Bookings" EntityType="Self.v_Active_Bookings" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [v_Active_Bookings].[booking_id] AS [booking_id], 
    [v_Active_Bookings].[user_id] AS [user_id], 
    [v_Active_Bookings].[user_fio] AS [user_fio], 
    [v_Active_Bookings].[room_id] AS [room_id], 
    [v_Active_Bookings].[room_description] AS [room_description], 
    [v_Active_Bookings].[check_in_date] AS [check_in_date], 
    [v_Active_Bookings].[check_out_date] AS [check_out_date], 
    [v_Active_Bookings].[guests_number] AS [guests_number], 
    [v_Active_Bookings].[total_price] AS [total_price]
    FROM [dbo].[v_Active_Bookings] AS [v_Active_Bookings]</DefiningQuery>
          </EntitySet>
          <EntitySet Name="v_Bookings_Details" EntityType="Self.v_Bookings_Details" store:Type="Views" store:Schema="dbo">
            <DefiningQuery>SELECT 
    [v_Bookings_Details].[booking_id] AS [booking_id], 
    [v_Bookings_Details].[user_id] AS [user_id], 
    [v_Bookings_Details].[user_fio] AS [user_fio], 
    [v_Bookings_Details].[room_id] AS [room_id], 
    [v_Bookings_Details].[room_description] AS [room_description], 
    [v_Bookings_Details].[check_in_date] AS [check_in_date], 
    [v_Bookings_Details].[check_out_date] AS [check_out_date], 
    [v_Bookings_Details].[guests_number] AS [guests_number], 
    [v_Bookings_Details].[total_price] AS [total_price], 
    [v_Bookings_Details].[booking_status] AS [booking_status], 
    [v_Bookings_Details].[payment_id] AS [payment_id], 
    [v_Bookings_Details].[payment_amount] AS [payment_amount], 
    [v_Bookings_Details].[payment_status] AS [payment_status]
    FROM [dbo].[v_Bookings_Details] AS [v_Bookings_Details]</DefiningQuery>
          </EntitySet>
